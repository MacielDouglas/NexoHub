generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  displayName   String?
  globalRole    String   @default("member")
  language      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  members             Member[]
  invitations         Invitation[]
  createdInviteTokens InviteToken[] @relation("CreatedInviteTokens")
  usedInviteTokens    InviteToken[] @relation("UsedInviteTokens")

  person Person?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             Member[]
  invitations         Invitation[]
  meetingConfigs      MeetingConfig[]
  specialEvents       SpecialEvent[]
  inviteTokens        InviteToken[]
  cleaningConfig      CleaningConfig?
  cleaningSchedules   CleaningSchedule[]
  meetingContents     MeetingContent[]
  meetings            Meeting[]
  families            Family[]
  people              Person[]
  subOrganizations    SubOrganization[]
  designationConfig   DesignationConfig?
  designationPrograms DesignationProgram[]
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
}

model InviteToken {
  id             String    @id @default(cuid())
  code           String    @unique
  purpose        String    @default("owner")
  organizationId String?
  createdById    String
  usedById       String?
  usedAt         DateTime?
  expiresAt      DateTime
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("CreatedInviteTokens", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy       User?         @relation("UsedInviteTokens", fields: [usedById], references: [id])
}

model MeetingConfig {
  id                          String   @id @default(cuid())
  organizationId              String
  type                        String   @default("midweek")
  dayOfWeek                   Int
  startTime                   String
  isActive                    Boolean  @default(true)
  defaultSentinelaConductorId String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  organization              Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parts                     MeetingPart[]
  defaultSentinelaConductor Person?       @relation("DefaultSentinelaConductor", fields: [defaultSentinelaConductorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, type])
}

model MeetingPart {
  id              String   @id @default(cuid())
  meetingConfigId String
  name            String
  durationMinutes Int?
  sortOrder       Int
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  meetingConfig MeetingConfig @relation(fields: [meetingConfigId], references: [id], onDelete: Cascade)
}

model Meeting {
  id             String   @id @default(cuid())
  organizationId String
  type           String // "midweek" | "weekend" | "memorial"
  weekStart      DateTime
  program        Json? // programa personalizado (seções/partes/tempos)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  MeetingAssignment[]

  @@unique([organizationId, type, weekStart])
  @@index([organizationId, weekStart])
}

model MeetingAssignment {
  id             String   @id @default(cuid())
  meetingId      String
  role           String
  sortOrder      Int      @default(0)
  personId       String?
  subOrgPersonId String?
  contentItemId  String?
  value          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting      Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person       Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  subOrgPerson SubOrgPerson?       @relation(fields: [subOrgPersonId], references: [id], onDelete: SetNull)
  contentItem  MeetingContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([personId])
  @@index([subOrgPersonId])
  @@index([contentItemId])
}

model SpecialEvent {
  id             String    @id @default(cuid())
  organizationId String
  type           String
  date           DateTime
  endDate        DateTime?
  time           String?
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
}

model CleaningConfig {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  weeklyEnabled       Boolean  @default(false)
  weeklyDayOfWeek     Int?
  weeklyIntervalWeeks Int      @default(1)
  generalEnabled      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sectors      CleaningSector[]
}

model CleaningSector {
  id               String   @id @default(cuid())
  cleaningConfigId String
  type             String
  defaultKey       String?
  name             String?
  task             String?
  unit             String
  peopleCount      Int?
  allowYoung       Boolean  @default(false)
  gender           String   @default("any")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cleaningConfig CleaningConfig @relation(fields: [cleaningConfigId], references: [id], onDelete: Cascade)

  cleaningAssignments CleaningAssignment[]

  @@index([cleaningConfigId, type])
}

model CleaningSchedule {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  CleaningAssignment[]

  @@index([organizationId, type])
  @@index([organizationId, startDate, endDate])
}

model CleaningAssignment {
  id         String   @id @default(cuid())
  scheduleId String
  date       DateTime
  sectorId   String
  personId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule CleaningSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sector   CleaningSector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  person   Person           @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date, sectorId, personId])
  @@index([scheduleId])
  @@index([date])
  @@index([sectorId])
  @@index([personId])
}

model DesignationConfig {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  micCount         Int      @default(1)
  indicadorCount   Int      @default(1)
  indicadorSectors Json? // lista de setores, um por indicador
  enabledSectors   Json? // lista de setores ativos: som, video, palco, mic, indicador
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DesignationProgram {
  id             String   @id @default(cuid())
  organizationId String
  startDate      DateTime
  endDate        DateTime
  enabledSectors Json? // lista de setores ativos na geração do programa
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  DesignationAssignment[]

  @@index([organizationId, startDate, endDate])
}

model DesignationAssignment {
  id        String   @id @default(cuid())
  programId String
  date      DateTime
  role      String // "som" | "video" | "palco" | "mic" | "indicador"
  sector    String?
  personId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program DesignationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  person  Person             @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([date])
  @@index([personId])
}

model MeetingContent {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  title          String
  symbol         String?
  coverTitle     String?
  issue          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MeetingContentItem[]

  @@index([organizationId, type])
}

model MeetingContentItem {
  id        String   @id @default(cuid())
  contentId String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content            MeetingContent      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  personTalks        PersonTalk[]
  subOrgPersonTalks  SubOrgPersonTalk[]
  meetingAssignments MeetingAssignment[]

  @@index([contentId])
}

enum Sex {
  MALE
  FEMALE
}

model Family {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  chefeId        String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chefe        Person?      @relation("FamilyHead", fields: [chefeId], references: [id], onDelete: SetNull)
  people       Person[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Person {
  id                String  @id @default(cuid())
  organizationId    String
  name              String
  sex               Sex
  active            Boolean @default(true)
  young             Boolean @default(false)
  batizado          Boolean @default(false)
  limpeza           Boolean @default(true)
  estudante         Boolean @default(true)
  privilegioServico Boolean @default(false)

  chefeFamilia Boolean @default(false)
  casada       Boolean @default(false)
  familyId     String?

  iniciarConversas  Boolean @default(false)
  cultivarInteresse Boolean @default(false)
  fazerDiscipulos   Boolean @default(false)
  explicarCrencas   Boolean @default(false)

  leituraBiblia    Boolean @default(false)
  microfoneVolante Boolean @default(false)
  som              Boolean @default(false)
  video            Boolean @default(false)
  palco            Boolean @default(false)

  leitorEstudoBiblico Boolean @default(false)
  leitorSentinela     Boolean @default(false)
  indicador           Boolean @default(false)
  oracao              Boolean @default(false)

  anciao                   Boolean @default(false)
  presidenteVidaMinisterio Boolean @default(false)
  discursoTesouros         Boolean @default(false)
  joiasEspirituais         Boolean @default(false)
  nossaVidaCrista          Boolean @default(false)
  necessidadesLocais       Boolean @default(false)
  condutorEstudoBiblico    Boolean @default(false)
  presidenteFimSemana      Boolean @default(false)
  discursoPublico          Boolean @default(false)
  condutorSentinela        Boolean @default(false)

  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  family                     Family?                 @relation(fields: [familyId], references: [id], onDelete: SetNull)
  user                       User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  chefeOfFamily              Family?                 @relation("FamilyHead")
  personTalks                PersonTalk[]
  cleaningAssignments        CleaningAssignment[]
  meetingAssignments         MeetingAssignment[]
  designationAssignments     DesignationAssignment[]
  sentinelaConductorDefaults MeetingConfig[]         @relation("DefaultSentinelaConductor")

  @@index([organizationId, sex])
  @@index([organizationId, active])
  @@index([familyId])
}

model PersonTalk {
  id                   String   @id @default(cuid())
  personId             String
  meetingContentItemId String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  person             Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  meetingContentItem MeetingContentItem @relation(fields: [meetingContentItemId], references: [id], onDelete: Cascade)
  dates              TalkDate[]

  @@unique([personId, meetingContentItemId])
  @@index([personId])
  @@index([meetingContentItemId])
}

model TalkDate {
  id           String   @id @default(cuid())
  personTalkId String
  date         DateTime
  notes        String?
  createdAt    DateTime @default(now())

  personTalk PersonTalk @relation(fields: [personTalkId], references: [id], onDelete: Cascade)

  @@index([personTalkId])
  @@index([date])
}

model SubOrganization {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  people       SubOrgPerson[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model SubOrgPerson {
  id                String   @id @default(cuid())
  subOrganizationId String
  name              String
  batizado          Boolean  @default(false)
  privilegioServico Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subOrganization    SubOrganization     @relation(fields: [subOrganizationId], references: [id], onDelete: Cascade)
  talks              SubOrgPersonTalk[]
  meetingAssignments MeetingAssignment[]

  @@index([subOrganizationId])
}

model SubOrgPersonTalk {
  id                   String    @id @default(cuid())
  subOrgPersonId       String
  meetingContentItemId String
  date                 DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  subOrgPerson       SubOrgPerson       @relation(fields: [subOrgPersonId], references: [id], onDelete: Cascade)
  meetingContentItem MeetingContentItem @relation(fields: [meetingContentItemId], references: [id], onDelete: Cascade)

  @@unique([subOrgPersonId, meetingContentItemId])
  @@index([subOrgPersonId])
  @@index([meetingContentItemId])
}
