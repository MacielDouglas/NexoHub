generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  displayName   String?
  globalRole    String    @default("member")
  language      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  members            Member[]
  invitations        Invitation[]
  createdInviteTokens InviteToken[] @relation("CreatedInviteTokens")
  usedInviteTokens    InviteToken[] @relation("UsedInviteTokens")

  person Person?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         Member[]
  invitations     Invitation[]
  meetingConfigs  MeetingConfig[]
  specialEvents   SpecialEvent[]
  inviteTokens    InviteToken[]
  cleaningConfig  CleaningConfig?
  meetingContents MeetingContent[]
  families        Family[]
  people          Person[]
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String    @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
}

model InviteToken {
  id             String   @id @default(cuid())
  code           String   @unique
  purpose        String   @default("owner")
  organizationId String?
  createdById    String
  usedById       String?
  usedAt         DateTime?
  expiresAt      DateTime
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User         @relation("CreatedInviteTokens", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy        User?        @relation("UsedInviteTokens", fields: [usedById], references: [id])
}

model MeetingConfig {
  id              String   @id @default(cuid())
  organizationId  String
  type            String   @default("midweek")
  dayOfWeek       Int
  startTime       String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parts        MeetingPart[]

  @@unique([organizationId, type])
}

model MeetingPart {
  id              String   @id @default(cuid())
  meetingConfigId String
  name            String
  durationMinutes Int?
  sortOrder       Int
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  meetingConfig MeetingConfig @relation(fields: [meetingConfigId], references: [id], onDelete: Cascade)
}

model SpecialEvent {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  date           DateTime
  endDate        DateTime?
  time           String?
  location       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
}

model CleaningConfig {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  weeklyEnabled       Boolean  @default(false)
  weeklyDayOfWeek     Int?
  weeklyIntervalWeeks Int      @default(1)
  generalEnabled      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sectors      CleaningSector[]
}

model CleaningSector {
  id              String   @id @default(cuid())
  cleaningConfigId String
  type            String
  defaultKey      String?
  name            String?
  task            String?
  unit            String
  peopleCount     Int?
  allowYoung      Boolean  @default(false)
  gender          String   @default("any")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cleaningConfig CleaningConfig @relation(fields: [cleaningConfigId], references: [id], onDelete: Cascade)

  @@index([cleaningConfigId, type])
}

model MeetingContent {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  title          String
  symbol         String?
  coverTitle     String?
  issue          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MeetingContentItem[]

  @@index([organizationId, type])
}

model MeetingContentItem {
  id        String   @id @default(cuid())
  contentId String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content MeetingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

enum Sex {
  MALE
  FEMALE
}

model Family {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  chefeId        String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chefe        Person?    @relation("FamilyHead", fields: [chefeId], references: [id], onDelete: SetNull)
  people       Person[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Person {
  id                     String   @id @default(cuid())
  organizationId         String
  name                   String
  sex                    Sex
  active                 Boolean  @default(true)
  young                  Boolean  @default(false)
  batizado               Boolean  @default(false)
  limpeza                Boolean  @default(true)
  estudante              Boolean  @default(true)
  privilegioServico      Boolean  @default(false)

  chefeFamilia           Boolean  @default(false)
  casada                 Boolean  @default(false)
  familyId               String?

  iniciarConversas       Boolean  @default(false)
  cultivarInteresse      Boolean  @default(false)
  fazerDiscipulos        Boolean  @default(false)
  explicarCrencas        Boolean  @default(false)

  leituraBiblia          Boolean  @default(false)
  microfoneVolante       Boolean  @default(false)
  som                    Boolean  @default(false)
  video                  Boolean  @default(false)
  palco                  Boolean  @default(false)

  leitorEstudoBiblico    Boolean  @default(false)
  leitorSentinela        Boolean  @default(false)
  indicador              Boolean  @default(false)
  oracao                 Boolean  @default(false)

  anciao                 Boolean  @default(false)
  presidenteVidaMinisterio Boolean  @default(false)
  discursoTesouros       Boolean  @default(false)
  joiasEspirituais       Boolean  @default(false)
  nossaVidaCrista        Boolean  @default(false)
  necessidadesLocais     Boolean  @default(false)
  condutorEstudoBiblico  Boolean  @default(false)
  presidenteFimSemana    Boolean  @default(false)
  discursoPublico        Boolean  @default(false)
  condutorSentinela      Boolean  @default(false)

  userId                 String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  family       Family?    @relation(fields: [familyId], references: [id], onDelete: SetNull)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  chefeOfFamily Family?  @relation("FamilyHead")

  @@index([organizationId, sex])
  @@index([organizationId, active])
  @@index([familyId])
}
